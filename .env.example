# Port server. Platform hosting biasanya menyuntikkan PORT sendiri.
PORT=3000

# Dari Supabase Dashboard > Project Settings > API
SUPABASE_URL=
# Publishable key (sb_publishable_...) atau anon key lama. Aman secara desain karena dibatasi RLS.
SUPABASE_PUBLISHABLE_KEY=

# Origin frontend yang diizinkan CORS. Pisahkan dengan koma untuk beberapa origin.
# Contoh: http://localhost:5173,https://nama-app.vercel.app
FRONTEND_URL=http://localhost:5173
